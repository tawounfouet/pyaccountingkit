# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/
.eggs/

# Environments
.venv/
venv/
env/
ENV/

# Test / coverage artifacts
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/
.hypothesis/

# Type-checking
.pyre/
.yarn/

# Mutation
.python-version

# Editors / OS
.vscode/
.idea/
.DS_Store

# Local golden fixtures
tests/golden/**/*.actual.json

# Documentation build
docs/_build/

# Local / temporary / generated data (never commit)
data/local/*
!data/local/.gitkeep
data/cache/*
!data/cache/.gitkeep
data/generated/*
!data/generated/.gitkeep

# Never commit confidential accounting or customer data
*.private.*
*.private.csv
*.private.json
*.private.parquet
*.private.txt

